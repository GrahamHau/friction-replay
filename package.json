{
  "name": "friction-replay",
  "version": "0.1.0",
  "description": "Record rrweb session replay in memory and upload only the minutes around user friction (rage clicks, dead clicks, errors, abandoned forms).",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --test \"test/*.test.ts\"",
    "demo": "npm run build && node examples/server.ts"
  },
  "keywords": [
    "rrweb",
    "session-replay",
    "replay",
    "rage-click",
    "dead-click",
    "frontend-monitoring"
  ],
  "type": "module",
  "devDependencies": {
    "@rrweb/record": "^2.1.4",
    "@rrweb/replay": "^2.1.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "jsdom": "^26.1.0",
    "typescript": "5.9"
  },
  "license": "MIT",
  "author": "GrahamHau",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GrahamHau/friction-replay.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./player": {
      "types": "./dist/player.d.ts",
      "default": "./dist/player.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.18"
  },
  "peerDependencies": {
    "@rrweb/record": "^2.1.4",
    "@rrweb/replay": "^2.1.4"
  },
  "peerDependenciesMeta": {
    "@rrweb/record": {
      "optional": true
    },
    "@rrweb/replay": {
      "optional": true
    }
  }
}
